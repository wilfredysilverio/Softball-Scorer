@* Ajusta el tipo de modelo si usas un DashboardViewModel específico *@
@* @model Scoreboard.Web.ViewModels.DashboardViewModel *@

@{
    ViewData["Title"] = "Inicio";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">Inicio</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Equipos" asp-action="Create" class="btn btn-outline-primary btn-sm">
                + Crear Equipo
            </a>
            <a asp-controller="Jugadores" asp-action="Create" class="btn btn-outline-success btn-sm">
                + Crear Jugador
            </a>
            <a asp-controller="Partidos" asp-action="Create" class="btn btn-outline-warning btn-sm">
                + Crear Partido
            </a>
            <a asp-controller="Home" asp-action="RepopularDatos" class="btn btn-outline-secondary btn-sm">
                Repoblar datos
            </a>
        </div>
    </div>

    <!-- Tarjetas de estadísticas -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6">👥</div>
                    <div>
                        <div class="text-muted small">Equipos</div>
                        <div class="fs-4 fw-semibold">
                            @* reemplaza por tu dato real *@
                            @ViewBag.TotalEquipos
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6">🏃</div>
                    <div>
                        <div class="text-muted small">Jugadores</div>
                        <div class="fs-4 fw-semibold">
                            @ViewBag.TotalJugadores
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6">🏆</div>
                    <div>
                        <div class="text-muted small">Partidos</div>
                        <div class="fs-4 fw-semibold">
                            @ViewBag.TotalPartidos
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6">📅</div>
                    <div>
                        <div class="text-muted small">Próximo juego</div>
                        <div class="fw-semibold">
                            @* Muestra fecha o guión *@
                            @(ViewBag.ProximoJuego ?? "—")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actividad reciente -->
    <div class="row g-3">
        <!-- Jugadores recientes -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 pb-0">
                    <h5 class="card-title mb-1">Actividad reciente: Jugadores</h5>
                    <p class="text-muted small mb-0">
                        Últimos jugadores registrados o actualizados.
                    </p>
                </div>
                <div class="card-body">
                    @if (ViewBag.UltimosJugadores == null || ((IEnumerable<dynamic>)ViewBag.UltimosJugadores).Count() == 0)
                    {
                        <div class="text-muted small">No hay actividad reciente.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var j in ViewBag.UltimosJugadores)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <a asp-controller="Jugadores" asp-action="Details" asp-route-id="@j.Id">
                                            @j.Nombre @j.Apellido
                                        </a>
                                        <div class="text-muted small">
                                            @j.FechaTexto
                                        </div>
                                    </div>
                                    <a asp-controller="Jugadores" asp-action="Edit" asp-route-id="@j.Id" class="btn btn-outline-secondary btn-sm">
                                        Editar
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Partidos recientes -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 pb-0">
                    <h5 class="card-title mb-1">Actividad reciente: Partidos</h5>
                    <p class="text-muted small mb-0">
                        Últimos juegos creados o modificados.
                    </p>
                </div>
                <div class="card-body">
                    @if (ViewBag.UltimosPartidos == null || ((IEnumerable<dynamic>)ViewBag.UltimosPartidos).Count() == 0)
                    {
                        <div class="text-muted small">No hay partidos recientes.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var p in ViewBag.UltimosPartidos)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <a asp-controller="Partidos" asp-action="Details" asp-route-id="@p.Id">
                                            @p.Titulo
                                        </a>
                                        <div class="text-muted small">
                                            @p.FechaTexto
                                        </div>
                                    </div>
                                    <a asp-controller="Partidos" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">
                                        Editar
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

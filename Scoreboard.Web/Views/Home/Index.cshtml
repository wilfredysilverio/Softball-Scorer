@model Scoreboard.Web.Modelos.ViewModels.HomeDashboardVm
@{
    ViewData["Title"] = "Inicio";   // ← Título de la página (pestaña y layout)
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="d-flex align-items-center mb-4">
        <h1 class="me-auto">Inicio</h1>  <!-- ← Título visible en la página -->
        <div>
            <a asp-controller="Equipos" asp-action="Create" class="btn btn-outline-primary me-2">Crear Equipo</a>
            <a asp-controller="Jugadores" asp-action="Create" class="btn btn-outline-success me-2">Crear Jugador</a>
            <a asp-controller="Partidos" asp-action="Create" class="btn btn-outline-warning">Crear Partido</a>

            @* Solo en Development: botón para poblar datos de ejemplo *@
            @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
            {
                <form method="post" asp-action="SeedDevData" class="d-inline ms-2">
                    <button type="submit" class="btn btn-outline-secondary"
                            data-confirm="Repoblar datos de ejemplo (solo Development)">
                        Repoblar datos
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Tarjetas KPI -->
    <div class="row g-3">
        <div class="col-12 col-md-3">
            <div class="card shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="me-3 display-6 text-primary"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <div class="text-muted small">Equipos</div>
                        <div class="h4">@Model.TotalEquipos</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="card shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="me-3 display-6 text-success"><i class="bi bi-person-lines-fill"></i></div>
                    <div>
                        <div class="text-muted small">Jugadores</div>
                        <div class="h4">@Model.TotalJugadores</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="card shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="me-3 display-6 text-warning"><i class="bi bi-trophy-fill"></i></div>
                    <div>
                        <div class="text-muted small">Partidos</div>
                        <div class="h4">@Model.TotalPartidos</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="card shadow-sm p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="me-3 display-6 text-info"><i class="bi bi-calendar-event-fill"></i></div>
                    <div>
                        <div class="text-muted small">Próximo juego</div>
                        <div class="h6">
                            @(Model.ProximoJuego.HasValue
                                                        ? Model.ProximoJuego.Value.ToLocalTime().ToString("g")
                                                        : "—")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Listas de actividad -->
    <div class="row mt-4 g-3">
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Actividad reciente: Jugadores</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @if (!Model.JugadoresRecientes.Any())
                    {
                        <li class="list-group-item text-muted small">Sin actividad reciente.</li>
                    }
                    else
                    {
                        @foreach (var j in Model.JugadoresRecientes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <a asp-controller="Jugadores" asp-action="Details" asp-route-id="@j.Id">
                                        @j.NombreCompleto
                                    </a>
                                    <div class="text-muted small">@j.Fecha.ToLocalTime().ToString("g")</div>
                                </div>
                                <a asp-controller="Jugadores" asp-action="Edit" asp-route-id="@j.Id"
                                   class="btn btn-sm btn-outline-primary">Editar</a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card shadow-sm p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Actividad reciente: Partidos</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @if (!Model.PartidosRecientes.Any())
                    {
                        <li class="list-group-item text-muted small">Sin actividad reciente.</li>
                    }
                    else
                    {
                        @foreach (var p in Model.PartidosRecientes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <a asp-controller="Partidos" asp-action="Details" asp-route-id="@p.Id">
                                        @p.Descripcion
                                    </a>
                                    <div class="text-muted small">@p.Fecha.ToLocalTime().ToString("g")</div>
                                </div>
                                <a asp-controller="Partidos" asp-action="Edit" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-primary">Editar</a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

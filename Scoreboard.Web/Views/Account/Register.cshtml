@{
    ViewData["Title"] = "Crear cuenta";
    string? returnUrl = ViewData["ReturnUrl"] as string;
}
<div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">
  <div class="card p-4 shadow" style="width:420px;">
    <h5 class="mb-3 text-center">Crear cuenta</h5>
    <form asp-action="Register" method="post">
      @Html.AntiForgeryToken()
      <input type="hidden" name="returnUrl" value="@returnUrl" />
      <div class="mb-3">
        <label class="form-label">Usuario</label>
        <input name="usuario" class="form-control" />
      </div>
      <div class="mb-3">
        <label class="form-label">Correo</label>
        <input name="email" type="email" class="form-control" />
      </div>
      <div class="mb-3">
        <label class="form-label">Clave</label>
        <input name="password" type="password" class="form-control" />
      </div>
      <div class="mb-3">
        <label class="form-label">Confirmar clave</label>
        <input name="confirmPassword" type="password" class="form-control" />
      </div>
      <button class="btn btn-success w-100" type="submit">Crear cuenta</button>
    </form>
    <div class="text-center mt-3">
      <a asp-action="Login" asp-route-returnUrl="@returnUrl">Ya tengo una cuenta</a>
    </div>
  </div>
</div>
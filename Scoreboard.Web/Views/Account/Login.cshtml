@model Scoreboard.Web.ViewModels.LoginViewModel
@{
    Layout = "_AuthLayout"; ViewData["Title"] = "Entrar"; var returnUrl = (string)(ViewData["ReturnUrl"] ?? "/");
}

<div class="softball-brand mb-3">
    <img src="~/img/softball-scorer-logo.svg" alt="Softball-Scorer" onerror="this.style.display='none'">
    <h1 class="auth-title m-0">Softball-Scorer</h1>
</div>
<p class="auth-sub mb-4">Inicia sesión para continuar.</p>

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Correo</label>
        <input asp-for="Email" class="form-control form-control-lg" placeholder="tu@correo.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Password" class="form-label">Contraseña</label>
        <input asp-for="Password" class="form-control form-control-lg" placeholder="Tu contraseña" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Mantenerme conectado</label>
        </div>
       
    </div>
    <button class="btn btn-primary btn-lg w-100 mb-3" type="submit">Entrar</button>
</form>

<!-- Mensaje de error ÚNICO en rojo (igual que ya lo tienes) -->
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger mt-3" role="alert">
        @ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage
    </div>
}



<!-- Bloque SIEMPRE visible para registro (estilo normal, no rojo) -->
<div class="text-center mt-3">
    <span class="text-muted">¿Aún no tienes cuenta?</span>
    <a asp-controller="Account" asp-action="Register" class="ms-1">Crear una cuenta</a>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



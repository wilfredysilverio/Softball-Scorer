@model Scoreboard.Web.ViewModels.LoginViewModel
@{
    // Si no tienes Views/Shared/_AuthLayout.cshtml usa el layout normal:
    // Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
    var returnUrl = (string)(ViewData["ReturnUrl"] ?? "/");
}

<div class="softball-brand mb-3">
    <img src="~/img/ball.svg" alt="Softball" onerror="this.style.display='none'">
    <h1 class="auth-title m-0">Softball-Scorer</h1>
</div>
<p class="auth-sub mb-4">Inicia sesión para continuar.</p>

<form asp-action="Login" method="post" asp-antiforgery="true" novalidate>
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <!-- Resumen de validación (muestra el primer error arriba) -->
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Correo</label>
        <input asp-for="Email"
               class="form-control form-control-lg"
               placeholder="tu@correo.com"
               autocomplete="username"
               autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Password" class="form-label">Contraseña</label>
        <input asp-for="Password"
               class="form-control form-control-lg"
               placeholder="Tu contraseña"
               type="password"
               autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Mantenerme conectado</label>
        </div>
    </div>

    <button class="btn btn-primary btn-lg w-100 mb-3" type="submit">Entrar</button>
</form>

<!-- Mensaje de error ÚNICO en rojo (si quieres mantenerlo) -->
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger mt-3" role="alert">
        @ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage
    </div>
}

<div class="text-center mt-3">
    <span class="text-muted">¿Aún no tienes cuenta?</span>
    <a asp-controller="Account" asp-action="Register" class="ms-1">Crear una cuenta</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

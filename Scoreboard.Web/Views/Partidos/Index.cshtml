@model IEnumerable<Scoreboard.Web.Modelos.Partido>
    @{
    ViewData["Title"] = "Partidos";
    }
    <h1>Partidos</h1>
    <p>
        <a asp-controller="Home" asp-action="Index">← Volver</a> |
        <a class="btn btn-primary" asp-action="Create">Crear partido</a>
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Casa</th>
                <th>Visita</th>
                <th>Marcador</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
  {
            <tr class="fila-partido" data-id="@p.Id" tabindex="0" role="button" aria-controls="acciones-partido-@p.Id" aria-expanded="false">
                <td>@p.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@p.EquipoCasa?.Nombre</td>
                <td>@p.EquipoVisita?.Nombre</td>
                <td>@p.CarrerasCasa - @p.CarrerasVisita</td>
                <td class="text-end small text-muted">
                    <span class="toggle-caret" aria-hidden="true">▸</span>
                    <span class="visually-hidden">Mostrar acciones</span>
                </td>
            </tr>
            <tr class="collapse acciones-partido" id="acciones-partido-@p.Id">
                <td colspan="5" class="py-3">
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="VerPartido" asp-route-id="@p.Id" class="btn btn-outline-info btn-sm">⚾ Ver partido</a>
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-outline-danger btn-sm" data-confirm="¿Eliminar partido?">Eliminar</a>
                    </div>
                </td>
            </tr>
  }
        </tbody>
    </table>

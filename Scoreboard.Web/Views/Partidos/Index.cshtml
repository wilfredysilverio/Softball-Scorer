@model IEnumerable<Scoreboard.Web.Modelos.Partido>
    @{
    ViewData["Title"] = "Partidos";
    }
    <h2 class="mb-1">Partidos</h2>
    <p class="text-muted">Selecciona un partido para ver acciones rápidas como marcador, detalles, edición o eliminación.</p>

    <p>
        <a class="btn btn-primary" asp-action="Create">Crear partido</a>
    </p>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Fecha</th>
                        <th scope="col">Casa</th>
                        <th scope="col">Visita</th>
                        <th scope="col">Marcador</th>
                        <th scope="col" class="text-end" style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No hay partidos para mostrar.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model)
                        {
                            <tr class="fila-partido" data-id="@p.Id" tabindex="0" role="button" aria-controls="acciones-partido-@p.Id" aria-expanded="false">
                                <td>@p.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-semibold">@p.EquipoCasa?.Nombre</td>
                                <td>@p.EquipoVisita?.Nombre</td>
                                <td>@p.CarrerasCasa - @p.CarrerasVisita</td>
                                <td class="text-end small text-muted">
                                    <span class="toggle-caret" aria-hidden="true">▸</span>
                                    <span class="visually-hidden">Mostrar acciones</span>
                                </td>
                            </tr>
                            <tr class="collapse acciones-partido" id="acciones-partido-@p.Id">
                                <td colspan="5" class="py-3">
                                    <div class="d-flex gap-2 flex-wrap justify-content-end align-items-center">
                                        <a asp-action="VerPartido" asp-route-id="@p.Id" class="btn btn-outline-info btn-sm">⚾ Ver partido</a>
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">Detalles</a>
                                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                                <span class="visually-hidden">Opciones</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@p.Id" data-confirm="¿Eliminar partido?">Eliminar</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

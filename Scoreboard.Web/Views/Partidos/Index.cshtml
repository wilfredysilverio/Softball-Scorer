@model IEnumerable<Scoreboard.Web.Modelos.Partido>

@{
    ViewData["Title"] = "Partidos";
    var totalPartidos = Model?.Count() ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Partidos</h1>
        <p class="text-muted mb-0">
            Lista de todos los juegos registrados. Haz clic en un partido para ver más acciones.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            ← Inicio
        </a>
        <a class="btn btn-primary" asp-action="Create">
            + Crear partido
        </a>
    </div>
</div>

<div class="mb-3">
    <span class="badge bg-light text-dark">
        @totalPartidos partido@(totalPartidos == 1 ? "" : "s") registrados
    </span>
</div>

@if (totalPartidos == 0)
{
    <div class="alert alert-light border">
        Todavía no tienes partidos registrados. Crea el primero para comenzar a anotar.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 190px;">Fecha</th>
                    <th>Casa</th>
                    <th>Visita</th>
                    <th class="text-center" style="width: 140px;">Marcador</th>
                    <th class="text-end" style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var marcador = $"{p.CarrerasCasa} - {p.CarrerasVisita}";

                    <tr class="fila-partido"
                        data-bs-toggle="collapse"
                        data-bs-target="#acciones-partido-@p.Id"
                        aria-controls="acciones-partido-@p.Id"
                        aria-expanded="false"
                        role="button">
                        <td>
                            <span class="d-block fw-semibold">
                                @p.Fecha.ToString("yyyy-MM-dd")
                            </span>
                            <small class="text-muted">
                                @p.Fecha.ToString("HH:mm")
                            </small>
                        </td>
                        <td>
                            <div class="fw-semibold">
                                @p.EquipoCasa?.Nombre
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">
                                @p.EquipoVisita?.Nombre
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-primary fs-6">
                                @marcador
                            </span>
                        </td>
                        <td class="text-end text-muted">
                            <span class="toggle-caret" aria-hidden="true">▸</span>
                            <span class="visually-hidden">Mostrar acciones</span>
                        </td>
                    </tr>
                    <tr class="collapse acciones-partido" id="acciones-partido-@p.Id">
                        <td colspan="5" class="bg-light py-3">
                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                <a asp-action="VerPartido"
                                   asp-route-id="@p.Id"
                                   class="btn btn-outline-info btn-sm">
                                    ⚾ Ver partido
                                </a>
                                <a asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Detalles
                                </a>
                                <a asp-action="Edit"
                                   asp-route-id="@p.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Editar
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@p.Id"
                                   class="btn btn-outline-danger btn-sm"
                                   data-confirm="¿Eliminar partido?">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        // Girar la flechita cuando se abre/cierra el bloque de acciones
        document.addEventListener("DOMContentLoaded", function () {
            const filas = document.querySelectorAll(".fila-partido");

            filas.forEach(function (fila) {
                const targetSelector = fila.getAttribute("data-bs-target");
                const caret = fila.querySelector(".toggle-caret");
                const collapseEl = document.querySelector(targetSelector);

                if (!collapseEl || !caret) return;

                collapseEl.addEventListener("show.bs.collapse", function () {
                    caret.style.transform = "rotate(90deg)";
                });

                collapseEl.addEventListener("hide.bs.collapse", function () {
                    caret.style.transform = "rotate(0deg)";
                });
            });
        });
    </script>
}

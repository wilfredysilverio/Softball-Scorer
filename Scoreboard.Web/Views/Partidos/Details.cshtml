@model Scoreboard.Web.Modelos.Partido
@{
    ViewData["Title"] = "Partido";
}

<div class="page-shell">
    <div class="page-header">
        <div>
            <span class="score-kicker">Partido</span>
            <h1>@Model.EquipoVisita?.Nombre vs @Model.EquipoCasa?.Nombre</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <section class="work-panel">
        <div class="scoreboard-card">
            <div class="team-line">
                <span>@Model.EquipoVisita?.Nombre</span>
                <strong>@Model.CarrerasVisita</strong>
            </div>
            <div class="team-line team-home">
                <span>@Model.EquipoCasa?.Nombre</span>
                <strong>@Model.CarrerasCasa</strong>
            </div>
            <div class="game-situation">
                <span>@Model.Fecha.ToString("dd/MM/yyyy h:mm tt")</span>
                <span>@Model.Estado</span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-primary" asp-action="VerPartido" asp-route-id="@Model.Id">
                <i class="bi bi-clipboard2-pulse me-2"></i>Anotar
            </a>
            <a class="btn btn-outline-primary" asp-action="DefinirLineup" asp-route-id="@Model.Id">
                <i class="bi bi-people me-2"></i>Jugadores
            </a>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="bi bi-pencil me-2"></i>Editar
            </a>
            <a class="btn btn-outline-info" asp-action="MarcadorPublico" asp-route-id="@Model.Id">
                <i class="bi bi-display me-2"></i>Publico
            </a>
        </div>
    </section>
</div>

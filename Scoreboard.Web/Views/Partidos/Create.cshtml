@model Scoreboard.Web.Modelos.Partido
@{
    ViewData["Title"] = "Crear partido";
}

<div class="flow-shell">
    <div class="flow-header">
        <div>
            <span class="score-kicker">Paso 1 de 3</span>
            <h1>Nuevo partido</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="flow-steps mb-4">
        <div class="flow-step active"><strong>1</strong><span>Partido</span></div>
        <div class="flow-step"><strong>2</strong><span>Jugadores</span></div>
        <div class="flow-step"><strong>3</strong><span>Anotar</span></div>
    </div>

    <form asp-action="Create" method="post" id="form-crear-partido" class="row g-4">
        @Html.AntiForgeryToken()
        <div class="col-12 col-xl-8">
            <section class="work-panel">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-4">
                    <label class="form-label fw-bold" asp-for="Fecha">Fecha</label>
                    <input asp-for="Fecha" type="datetime-local" class="form-control form-control-lg" />
                    <span asp-validation-for="Fecha" class="text-danger small"></span>
                </div>

                <div class="matchup-picker">
                    <div class="team-pick">
                        <span>Visitante</span>
                        <label class="form-label fw-bold" asp-for="EquipoVisitaId">Equipo visitante</label>
                        <select asp-for="EquipoVisitaId" class="form-select form-select-lg" asp-items="ViewBag.EquiposVisita"></select>
                        <span asp-validation-for="EquipoVisitaId" class="text-danger small"></span>
                    </div>
                    <div class="versus-badge">VS</div>
                    <div class="team-pick home-pick">
                        <span>Casa</span>
                        <label class="form-label fw-bold" asp-for="EquipoCasaId">Equipo casa</label>
                        <select asp-for="EquipoCasaId" class="form-select form-select-lg" asp-items="ViewBag.EquiposCasa"></select>
                        <span asp-validation-for="EquipoCasaId" class="text-danger small"></span>
                    </div>
                </div>

                <div id="equipos-iguales-alert" class="alert alert-warning d-none mt-3">
                    El equipo de casa y el visitante deben ser diferentes.
                </div>

                <input asp-for="CarrerasCasa" type="hidden" value="0" />
                <input asp-for="CarrerasVisita" type="hidden" value="0" />

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg action-primary">
                        <i class="bi bi-arrow-right-circle me-2"></i>Continuar
                    </button>
                    <a asp-controller="Equipos" asp-action="Create" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-shield-plus me-2"></i>Crear equipo
                    </a>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <aside class="work-panel h-100 next-panel">
                <span class="score-kicker">Luego</span>
                <div class="next-big-step">
                    <i class="bi bi-people"></i>
                    <strong>Quita ausentes</strong>
                </div>
                <div class="next-big-step">
                    <i class="bi bi-clipboard2-pulse"></i>
                    <strong>Anota</strong>
                </div>
                <div class="next-big-step">
                    <i class="bi bi-download"></i>
                    <strong>Descarga</strong>
                </div>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('form-crear-partido');
            const casa = document.getElementById('EquipoCasaId');
            const visita = document.getElementById('EquipoVisitaId');
            const warning = document.getElementById('equipos-iguales-alert');

            function validateTeams() {
                const invalid = casa?.value && visita?.value && casa.value === visita.value;
                warning?.classList.toggle('d-none', !invalid);
                return !invalid;
            }

            casa?.addEventListener('change', validateTeams);
            visita?.addEventListener('change', validateTeams);

            form?.addEventListener('submit', function (e) {
                if (!validateTeams()) {
                    e.preventDefault();
                    visita?.focus();
                }
            });
        });
    </script>
}

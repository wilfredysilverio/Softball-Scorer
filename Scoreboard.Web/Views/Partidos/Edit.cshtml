@model Scoreboard.Web.Modelos.Partido
@{
    ViewData["Title"] = "Editar partido";
}

<div class="page-shell">
    <div class="page-header">
        <div>
            <span class="score-kicker">Editar</span>
            <h1>Partido</h1>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <form asp-action="Edit" method="post" class="form-panel">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <section class="work-panel">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-bold" asp-for="Fecha">Fecha</label>
                    <input asp-for="Fecha" type="datetime-local" class="form-control form-control-lg" />
                    <span asp-validation-for="Fecha" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold" asp-for="EquipoVisitaId">Visitante</label>
                    <select asp-for="EquipoVisitaId" class="form-select form-select-lg" asp-items="ViewBag.EquiposVisita"></select>
                    <span asp-validation-for="EquipoVisitaId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold" asp-for="EquipoCasaId">Casa</label>
                    <select asp-for="EquipoCasaId" class="form-select form-select-lg" asp-items="ViewBag.EquiposCasa"></select>
                    <span asp-validation-for="EquipoCasaId" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold" asp-for="CarrerasVisita">Carreras visitante</label>
                    <input asp-for="CarrerasVisita" class="form-control form-control-lg" />
                    <span asp-validation-for="CarrerasVisita" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold" asp-for="CarrerasCasa">Carreras casa</label>
                    <input asp-for="CarrerasCasa" class="form-control form-control-lg" />
                    <span asp-validation-for="CarrerasCasa" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save me-2"></i>Guardar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
            </div>
        </section>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

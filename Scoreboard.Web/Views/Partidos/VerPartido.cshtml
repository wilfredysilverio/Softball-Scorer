@model Scoreboard.Web.Modelos.ViewModels.VerPartidoVm
@using Scoreboard.Web.Modelos
@using System.Linq
@{
    ViewData["Title"] = "Ver partido";
    var partido = Model.Partido;
    var maxInnings = Model.MaxInnings;
    var motivoBloqueo = Model.MotivoBloqueoTurno;
    var puedeRegistrar = string.IsNullOrEmpty(motivoBloqueo);
    var hayCorredor = partido.B1 || partido.B2 || partido.B3;
    var equipoBateandoNombre = partido.Mitad == MitadEntrada.Baja
        ? partido.EquipoCasa?.Nombre ?? "Casa"
        : partido.EquipoVisita?.Nombre ?? "Visitante";
}

<div class="scorekeeper-shell">
    @* Mensajes de resultado de acciones *@
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="scorekeeper-header">
        <div class="scorekeeper-title">
            <span class="score-kicker">En vivo</span>
            <h2>
                <span>@partido.EquipoVisita?.Nombre</span>
                <strong><span id="score-visita">@partido.CarrerasVisita</span> - <span id="score-casa">@partido.CarrerasCasa</span></strong>
                <span>@partido.EquipoCasa?.Nombre</span>
            </h2>
        </div>
        <div class="scorekeeper-tools">
            <span class="badge bg-secondary">@partido.Fecha.ToString("dd/MM")</span>
            <a asp-action="BoxScoreCsv" asp-route-id="@partido.Id" class="btn btn-sm btn-outline-success">
                <i class="bi bi-download me-1"></i>Box score
            </a>
            <a asp-action="PlayByPlayCsv" asp-route-id="@partido.Id" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-list-check me-1"></i>Jugada por jugada
            </a>
        </div>
    </div>

    <div class="batting-status" id="batting-status" aria-live="polite">
        <span>Está bateando</span>
        <strong id="equipo-bateando">@equipoBateandoNombre</strong>
        <em id="estado-mitad">@partido.Mitad del @partido.EntradaActual ini</em>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-8 scorekeeper-main">
            <div class="card">
                <div class="card-header">
                    Entradas
                </div>
                <div class="card-body" id="marcador-wrapper">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle" id="tabla-entradas">
                            <thead>
                                <tr>
                                    <th>Equipo</th>
                                    @for (int i = 1; i <= maxInnings; i++)
                                    {
                                        <th class="text-center" data-inning="@i">@i</th>
                                    }
                                    <th class="text-center" data-total="true">C</th>
                                    <th class="text-center">H</th>
                                    <th class="text-center">E</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="fila-visita">
                                    <td class="fw-semibold">@partido.EquipoVisita?.Nombre</td>
                                    @for (int i = 1; i <= maxInnings; i++)
                                    {
                                        var entrada = partido.Entradas?.FirstOrDefault(e => e.NumeroInning == i);
                                        var r = (entrada?.CarrerasVisita) ?? 0;
                                    <td class="text-center" data-side="V" data-inning="@i">
                                        <div class="r fw-semibold">@r</div>
                                    </td>
                                    }
                                    <td class="text-center" data-total="true" id="totCarrerasVisita">@partido.CarrerasVisita</td>
                                    <td class="text-center" id="totHitsVisita">@partido.HitsVisita</td>
                                    <td class="text-center" id="totErroresVisita">@partido.ErroresVisita</td>
                                </tr>
                                <tr id="fila-casa">
                                    <td class="fw-semibold">@partido.EquipoCasa?.Nombre</td>
                                    @for (int i = 1; i <= maxInnings; i++)
                                    {
                                        var entrada = partido.Entradas?.FirstOrDefault(e => e.NumeroInning == i);
                                        var r = (entrada?.CarrerasCasa) ?? 0;
                                    <td class="text-center" data-side="C" data-inning="@i">
                                        <div class="r fw-semibold">@r</div>
                                    </td>
                                    }
                                    <td class="text-center" data-total="true" id="totCarrerasCasa">@partido.CarrerasCasa</td>
                                    <td class="text-center" id="totHitsCasa">@partido.HitsCasa</td>
                                    <td class="text-center" id="totErroresCasa">@partido.ErroresCasa</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="game-control-strip mt-3">
                        <div>Entrada: <span id="entradaActual">@partido.EntradaActual</span> <span id="mitadActual">(@partido.Mitad)</span></div>
                        <div class="outs-tracker d-flex align-items-center gap-2" aria-live="polite">
                            <span class="outs-label">Outs:</span>
                            <span class="outs-value" id="outs-count">
                                <span id="outs-valor">@Model.Outs</span>
                            </span>
                            <div class="outs-indicator" id="outs-indicator" aria-hidden="true">
                                @for (var i = 1; i <= 3; i++)
                                {
                                    var activeClass = Model.Outs >= i ? " active filled" : string.Empty;
                                    <span class="out-dot@activeClass" data-out-index="@i" id="out@i"></span>
                                }
                            </div>
                        </div>
                        <div class="base-diamond" aria-label="Corredores en base">
                            <span id="base2" class="base base-second @(partido.B2 ? "activa base-on" : string.Empty)" title="Segunda base"><small>2B</small></span>
                            <span id="base3" class="base base-third @(partido.B3 ? "activa base-on" : string.Empty)" title="Tercera base"><small>3B</small></span>
                            <span id="base1" class="base base-first @(partido.B1 ? "activa base-on" : string.Empty)" title="Primera base"><small>1B</small></span>
                            <span class="base-home"><small>H</small></span>
                        </div>
                    </div>

                    <div id="alertaMarcador" class="mt-3 d-none"></div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">Corredores</div>
                <div class="card-body">
                    <form asp-action="RegistrarEventoCorredor" asp-controller="Partidos" method="post" class="row g-2" data-live="evento">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PartidoId" value="@Model.Evento.PartidoId" />
                        <div class="col-12">
                            <label class="form-label" for="eventoCorredor">Tipo de evento</label>
                            <select name="Evento" id="eventoCorredor" class="form-select" @(hayCorredor ? string.Empty : "disabled")>
                                <option value="">Selecciona evento</option>
                                <option value="@((int)EventoCorredor.RoboBase)">Robo de base</option>
                                <option value="@((int)EventoCorredor.PassedBall)">Passed ball</option>
                                <option value="@((int)EventoCorredor.WildPitch)">Wild pitch</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="baseEvento">Corredor</label>
                            <select name="Base" id="baseEvento" class="form-select" @(hayCorredor ? string.Empty : "disabled")>
                                <option value="">Selecciona corredor</option>
                                <option value="@((int)BaseCorredor.Primera)" data-base="1">Corredor en 1B</option>
                                <option value="@((int)BaseCorredor.Segunda)" data-base="2">Corredor en 2B</option>
                                <option value="@((int)BaseCorredor.Tercera)" data-base="3">Corredor en 3B</option>
                            </select>
                        </div>
                        <div class="col-12 d-grid">
                            <button type="submit" id="btn-evento-corredor" class="btn btn-primary" @(hayCorredor ? string.Empty : "disabled")>Registrar evento</button>
                        </div>
                        <div class="col-12">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4 scorekeeper-side">
            <div class="card mb-3 lineup-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Lineup</span>
                    <a class="btn btn-sm btn-outline-primary" asp-action="DefinirLineup" asp-route-id="@partido.Id">Definir/Editar</a>
                </div>
                <div class="card-body">
                    <div>
                        <strong>Próximo:</strong>
                        <span id="lineup-proximo-bateador" class="@(Model.BateadorEsperado != null ? string.Empty : "text-muted")">
                            @if (Model.BateadorEsperado != null)
                            {
                                <text>@Model.BateadorEsperado.Nombre @Model.BateadorEsperado.Apellido (@Model.BateadorEsperado.NumeroUniforme)</text>
                            }
                            else
                            {
                                <text>Sin bateador asignado.</text>
                            }
                        </span>
                    </div>
                    @if (Model.BateadorEsperado == null)
                    {
                        <small class="text-muted">Falta lineup.</small>
                    }
                </div>
            </div>
            <div class="card mb-3 game-actions-card">
                <div class="card-header">Partido</div>
                <div class="card-body d-grid gap-2">
                    @* Mostrar acciones vÃ¡lidas segÃºn el estado actual. *@
                    @if (partido.Estado == EstadoPartido.NoIniciado)
                    {
                    <form asp-action="Iniciar" asp-controller="Partidos" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@partido.Id" />
                        <button type="submit" class="btn btn-success">Iniciar</button>
                    </form>
                    }
                    @if (partido.Estado == EstadoPartido.EnCurso)
                    {
                    <form asp-action="Suspender" asp-controller="Partidos" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@partido.Id" />
                        <button type="submit" class="btn btn-warning">Suspender</button>
                    </form>
                    }
                    @if (partido.Estado == EstadoPartido.Suspendido)
                    {
                    <form asp-action="Reanudar" asp-controller="Partidos" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@partido.Id" />
                        <button type="submit" class="btn btn-info">Reanudar</button>
                    </form>
                    }
                    @if (partido.Estado != EstadoPartido.Finalizado && partido.Estado != EstadoPartido.NoIniciado)
                    {
                    <form asp-action="Finalizar" asp-controller="Partidos" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@partido.Id" />
                        <button type="submit" class="btn btn-danger">Finalizar</button>
                    </form>
                    }
                    <form asp-action="Deshacer" asp-controller="Partidos" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partidoId" value="@partido.Id" />
                        <button type="submit" class="btn btn-outline-secondary">Deshacer</button>
                    </form>
                </div>
            </div>

            <div class="card turn-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Turno</span>
                    <small id="turno-equipo-bateando" class="text-muted">@equipoBateandoNombre</small>
                </div>
                <div class="card-body">
                    <div class="quick-results mb-3" aria-label="Resultados rápidos">
                        <button type="button" class="btn btn-outline-success btn-sm" data-result-text="Sencillo">Hit</button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-result-text="Doble">Doble</button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-result-text="Triple">Triple</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" data-result-text="Jonron">Jonrón</button>
                        <button type="button" class="btn btn-outline-dark btn-sm" data-result-text="Ponche">Ponche</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-result-text="OutEnJuego">Out</button>
                    </div>
                    <form asp-action="RegistrarTurno" asp-controller="Partidos" method="post" class="row g-2" data-live="registrar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PartidoId" value="@Model.Turno.PartidoId" />
                        <input type="hidden" id="turnoBateadorEsperadoId" value="@(Model.BateadorEsperado?.Id ?? 0)" />
                        <input type="hidden" id="confirmarFueraTurno" name="ConfirmarFueraTurno" value="false" />
                        <div class="col-12">
                            <div id="motivo-bloqueo-turno" class="@(string.IsNullOrEmpty(motivoBloqueo) ? "d-none" : "alert alert-warning mb-2")">
                                @motivoBloqueo
                            </div>
                        </div>
                        <fieldset class="row g-2" id="fieldset-registrar-turno" @(puedeRegistrar ? string.Empty : "disabled")>
                            <div class="col-12">
                                <label class="form-label" for="turnoJugadorId">Bateador</label>
                                <div class="small text-muted mb-1">
                                    Sigue: <span id="proximo-bateador">
                                        @if (Model.BateadorEsperado != null)
                                        {
                                            <text>@Model.BateadorEsperado.Nombre @Model.BateadorEsperado.Apellido (@Model.BateadorEsperado.NumeroUniforme)</text>
                                        }
                                        else
                                        {
                                            <text>Falta lineup.</text>
                                        }
                                    </span>
                                </div>
                                <select id="turnoJugadorId" name="JugadorId" class="form-select" data-expected-id="@(Model.BateadorEsperado?.Id ?? 0)" required>
                                    @foreach (var jugador in Model.Lineup)
                                    {
                                        var selected = Model.BateadorEsperado?.Id == jugador.Id;
                                        <option value="@jugador.Id" selected="@(selected ? "selected" : null)">@jugador.Nombre @jugador.Apellido (@jugador.NumeroUniforme)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="resultadoSelect">Resultado</label>
                                <select name="Resultado" id="resultadoSelect" class="form-select" required>
                                    @foreach (var option in Html.GetEnumSelectList<ResultadoTurno>())
                                    {
                                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 d-grid">
                                <button type="submit" id="btn-registrar-turno" class="btn btn-primary" @(puedeRegistrar ? string.Empty : "disabled")>Registrar</button>
                            </div>
                        </fieldset>
                        <div class="col-12">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-3 history-card">
                <div class="card-header p-0">
                    <button class="history-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#historial-reciente" aria-expanded="false" aria-controls="historial-reciente">
                        <span><i class="bi bi-clock-history me-1"></i> Historial</span>
                        <small>Ver jugadas</small>
                    </button>
                </div>
                <div class="collapse" id="historial-reciente">
                <div class="card-body">
                    @if (Model.UltimasJugadas.Any())
                    {
                        <div class="play-history" id="play-history">
                            @foreach (var log in Model.UltimasJugadas)
                            {
                                <div class="play-history__item">
                                    <div class="play-history__top">
                                        <strong>@(log.MitadContext ?? partido.Mitad.ToString()) @((log.EntradaContext ?? partido.EntradaActual)) ini</strong>
                                        <span>@log.Resultado</span>
                                    </div>
                                    <div class="play-history__body">
                                        @(log.Jugador?.Nombre) @(log.Jugador?.Apellido)
                                        @if (log.RunsScored > 0)
                                        {
                                            <span class="text-success fw-semibold">+@log.RunsScored carrera(s)</span>
                                        }
                                        @if (log.OutsAfter.HasValue)
                                        {
                                            <span>Outs: @log.OutsAfter</span>
                                        }
                                    </div>
                                    <div class="play-history__meta">
                                        @(log.BasesAfter ?? "Bases sin cambio")
                                        @if (log.EsCorreccionManual)
                                        {
                                            <span class="badge text-bg-warning">Fuera de turno confirmado</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Todavia no hay jugadas registradas.</p>
                    }
                </div>
                </div>
            </div>

        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" asp-controller="Partidos" class="btn btn-outline-dark">Volver</a>
    </div>
</div>

@section Scripts {
    <script>
        window.marcadorConfig = {
            partidoId: @partido.Id,
            marcadorJsonUrl: '@Url.Action("MarcadorJson","Partidos")'
        };
    </script>
    
    <!-- marcador.js ya se incluye globalmente en _Layout -->
}


@model Scoreboard.Web.Modelos.Partido
@{
    ViewData["Title"] = "Ver partido";
}

<div class="container py-4">
    <div class="card mb-3">
        <div class="card-body d-flex align-items-center">
            <div>
                <h4 class="mb-0">@Model.EquipoCasa?.Nombre</h4>
                <div class="text-muted small">Casa</div>
            </div>
            <div class="mx-auto text-center">
                <h2 id="main-score" class="mb-0" role="status" aria-live="polite">@Model.CarrerasCasa - @Model.CarrerasVisita</h2>
                <div class="text-muted">@Model.Fecha.ToString("g")</div>
            </div>
            <div class="text-end" style="min-width:180px;">
                <div class="d-flex flex-column align-items-end">
                    <div id="bases-view" class="mb-2" aria-hidden="true">
                        <!-- SVG diamond bases: each has id base-1 .. base-3; JS toggles class base-on -->
                        <svg class="base" id="base-3" viewBox="0 0 100 100" role="img" aria-label="3rd base" title="3rd base">
                            <polygon points="50,0 100,50 50,100 0,50" stroke="black" stroke-width="2" fill="currentColor" />
                        </svg>
                        <svg class="base" id="base-2" viewBox="0 0 100 100" role="img" aria-label="2nd base" title="2nd base">
                            <polygon points="50,0 100,50 50,100 0,50" stroke="black" stroke-width="2" fill="currentColor" />
                        </svg>
                        <svg class="base" id="base-1" viewBox="0 0 100 100" role="img" aria-label="1st base" title="1st base">
                            <polygon points="50,0 100,50 50,100 0,50" stroke="black" stroke-width="2" fill="currentColor" />
                        </svg>
                    </div>
                    <div id="outs-view" class="fw-bold" role="status" aria-live="polite">OUTS: <span id="outs-count">@Model.Outs</span></div>
                </div>
            </div>
            <div class="text-end">
                <h4 class="mb-0">@Model.EquipoVisita?.Nombre</h4>
                <div class="text-muted small">Visita</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="UpdateMarcador" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div id="scoreboard-table" class="table-responsive">
                    <table class="table table-bordered text-center align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="align-middle">Equipo</th>
                                @{
                                    // Determine innings to show (at least 9)
                                    var maxInnings = Math.Max(9, (Model.Entradas?.Max(e => (int?)e.NumeroInning) ?? 0));
                                }
                                @for (int i = 1; i <= maxInnings; i++)
                                {
                                    <th>@i</th>
                                }
                                <th>R</th>
                                <th>H</th>
                                <th>E</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-start fw-bold">@Model.EquipoCasa?.Nombre</td>
                                @for (int i = 1; i <= maxInnings; i++)
                                {
                                    var entrada = Model.Entradas?.FirstOrDefault(e => e.NumeroInning == i);
                                    <td>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <input type="number" class="form-control form-control-sm text-center" name="Entradas[@(i-1)].NumeroInning" value="@i" hidden />
                                            <input type="number" class="form-control form-control-sm text-center" name="Entradas[@(i-1)].CarrerasCasa" value="@(entrada?.CarrerasCasa ?? 0)" />
                                        }
                                        else
                                        {
                                            @((entrada != null) ? entrada.CarrerasCasa.ToString() : "-")
                                        }
                                    </td>
                                }
                                <td id="totCarrerasCasa" class="fw-bold" role="status" aria-live="polite">@Model.CarrerasCasa</td>
                                <td id="totHitsCasa" class="fw-bold" role="status" aria-live="polite">@Model.HitsCasa</td>
                                <td id="totErroresCasa" class="fw-bold" role="status" aria-live="polite">@Model.ErroresCasa</td>
                            </tr>

                            <tr>
                                <td class="text-start fw-bold">@Model.EquipoVisita?.Nombre</td>
                                @for (int i = 1; i <= maxInnings; i++)
                                {
                                    var entrada = Model.Entradas?.FirstOrDefault(e => e.NumeroInning == i);
                                    <td>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <input type="number" class="form-control form-control-sm text-center" name="Entradas[@(i-1)].NumeroInning" value="@i" hidden />
                                            <input type="number" class="form-control form-control-sm text-center" name="Entradas[@(i-1)].CarrerasVisita" value="@(entrada?.CarrerasVisita ?? 0)" />
                                        }
                                        else
                                        {
                                            @((entrada != null) ? entrada.CarrerasVisita.ToString() : "-")
                                        }
                                    </td>
                                }
                                <td id="totCarrerasVisita" class="fw-bold" role="status" aria-live="polite">@Model.CarrerasVisita</td>
                                <td id="totHitsVisita" class="fw-bold" role="status" aria-live="polite">@Model.HitsVisita</td>
                                <td id="totErroresVisita" class="fw-bold" role="status" aria-live="polite">@Model.ErroresVisita</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 d-flex justify-content-end gap-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <button type="submit" class="btn btn-success">Actualizar marcador</button>
                    }
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5>Acciones en vivo (Admin)</h5>

                <div class="d-flex gap-2 flex-wrap">
                    <form asp-action="Iniciar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary">Iniciar</button>
                    </form>

                    <form asp-action="Suspender" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-warning">Suspender</button>
                    </form>

                    <form asp-action="Reanudar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-info">Reanudar</button>
                    </form>

                    <form asp-action="Finalizar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">Finalizar</button>
                    </form>

                    <form asp-action="Deshacer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partidoId" value="@Model.Id" />
                        <button type="submit" class="btn btn-secondary">Deshacer última jugada</button>
                    </form>
                    
                    <form asp-action="Rehacer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partidoId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-secondary">Rehacer última jugada</button>
                    </form>
                </div>

                <hr />

                <h6>Registrar turno</h6>
                <form asp-action="RegistrarTurno" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="partidoId" value="@Model.Id" />

                    <div class="col-auto">
                        <label class="form-label small">Jugador</label>
                        <select name="jugadorId" class="form-select form-select-sm" required>
                            <option value="">-- seleccionar --</option>
                            @if (ViewBag.Bateadores != null)
                            {
                                foreach (var j in (List<Scoreboard.Web.Modelos.Jugador>)ViewBag.Bateadores)
                                {
                                    <option value="@j.Id">@j.NumeroUniforme - @j.Nombre @j.Apellido</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-auto">
                        <label class="form-label small">Resultado</label>
                        <select name="resultado" class="form-select form-select-sm">
                            @foreach (var r in Enum.GetValues(typeof(Scoreboard.Web.Modelos.ResultadoTurno)).Cast<Scoreboard.Web.Modelos.ResultadoTurno>())
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-success">Registrar turno</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="mt-3">
        @if (Model.CarrerasCasa == 0 && Model.CarrerasVisita == 0)
        {
            <div class="alert alert-info">Partido aún no iniciado</div>
        }
        else if (Model.EntradaActual > 9 && Model.Outs == 3)
        {
            <div class="alert alert-secondary">Finalizado</div>
        }
    </div>
</div>

@section Scripts {
    <style>
        /* Small visual helpers for bases and flashing */
        #bases-view .base { font-size: 20px; opacity: 0.25; margin-left: 6px; transition: opacity 300ms ease; }
        #bases-view .base-on { opacity: 1; color: orange; }
    .flash { animation: flashbg 700ms ease; }
    @@keyframes flashbg { from { background-color: rgba(255,255,0,0.7); } to { background-color: transparent; } }
    </style>

    <script>
        // Config para el script externo
        window.marcadorConfig = {
            partidoId: @Model.Id,
            marcadorJsonUrl: '@Url.Action("MarcadorJson", "Partidos")'
        };
    </script>

    <link rel="stylesheet" href="~/css/marcador.css" asp-append-version="true" />
    <script src="~/js/marcador.js" asp-append-version="true"></script>
}

    @if (User.IsInRole("Admin"))
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5>Controles del partido (Admin)</h5>
                <div class="d-flex gap-2 flex-wrap">
                    <form asp-action="Iniciar" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary">Iniciar partido</button>
                    </form>

                    <form asp-action="Suspender" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-warning">Suspender</button>
                    </form>

                    <form asp-action="Reanudar" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success">Reanudar</button>
                    </form>

                    <form asp-action="Finalizar" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">Finalizar</button>
                    </form>

                    <form asp-action="Deshacer" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partidoId" value="@Model.Id" />
                        <button type="submit" class="btn btn-secondary">Deshacer última jugada</button>
                    </form>

                    <form asp-action="Rehacer" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partidoId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-secondary">Rehacer última jugada</button>
                    </form>
                </div>

                <hr />

                <h6>Registrar turno</h6>
                <form asp-action="RegistrarTurno" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="partidoId" value="@Model.Id" />

                    <div class="col-auto">
                        <label class="form-label">Jugador</label>
                        <select name="jugadorId" class="form-select form-select-sm" required>
                            <option value="">-- seleccionar --</option>
                            @if (ViewBag.Bateadores != null)
                            {
                                foreach (var j in (List<Scoreboard.Web.Modelos.Jugador>)ViewBag.Bateadores)
                                {
                                    <option value="@j.Id">@j.NumeroUniforme - @j.Nombre @j.Apellido</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-auto">
                        <label class="form-label">Resultado</label>
                        <select name="resultado" class="form-select form-select-sm">
                            @foreach (var r in Enum.GetValues(typeof(Scoreboard.Web.Modelos.ResultadoTurno)))
                            {
                                <option value="@r">@r.ToString()</option>
                            }
                        </select>
                    </div>

                    <div class="col-auto align-self-end">
                        <button type="submit" class="btn btn-outline-primary">Registrar</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

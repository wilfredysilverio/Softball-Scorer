@using System.Text.Json
@{
    ViewData["Title"] = "Estadisticas";
    var labelsJson = ViewData["TeamLabels"] as string ?? "[]";
    var dataJson = ViewData["TeamData"] as string ?? "[]";
    var labels = JsonSerializer.Deserialize<List<string>>(labelsJson) ?? new List<string>();
    var data = JsonSerializer.Deserialize<List<int>>(dataJson) ?? new List<int>();
    var maxCarreras = data.DefaultIfEmpty(0).Max();
}

<div class="page-shell">
    <div class="page-header">
        <div>
            <span class="score-kicker">Resumen</span>
            <h1>Estadisticas</h1>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Inicio
        </a>
    </div>

    <section class="stat-grid mb-4">
        <div class="metric-tile"><span>Equipos</span><strong>@ViewData["TotalEquipos"]</strong></div>
        <div class="metric-tile"><span>Jugadores</span><strong>@ViewData["TotalJugadores"]</strong></div>
        <div class="metric-tile"><span>Partidos</span><strong>@ViewData["TotalPartidos"]</strong></div>
        <div class="metric-tile"><span>Carreras</span><strong>@ViewData["TotalCarreras"]</strong></div>
        <div class="metric-tile"><span>Promedio</span><strong>@ViewData["PromedioGeneral"]</strong></div>
        <div class="metric-tile metric-live"><span>Lider</span><strong>@(ViewData["EquipoMasCarrerasTotal"] ?? 0)</strong></div>
    </section>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <section class="work-panel">
                <div class="panel-title">
                    <div>
                        <span class="score-kicker">Equipos</span>
                        <h2>Carreras</h2>
                    </div>
                </div>

                @if (!labels.Any())
                {
                    <div class="empty-state compact">
                        <i class="bi bi-bar-chart"></i>
                        <p>Sin datos.</p>
                    </div>
                }
                else
                {
                    <div class="bar-list">
                        @for (var i = 0; i < labels.Count; i++)
                        {
                            var value = i < data.Count ? data[i] : 0;
                            var width = maxCarreras > 0 ? Math.Max(8, (int)Math.Round(value * 100m / maxCarreras)) : 8;
                            <div class="bar-row">
                                <div class="bar-row__head">
                                    <strong>@labels[i]</strong>
                                    <span>@value</span>
                                </div>
                                <div class="bar-track"><span style="width:@width%"></span></div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="work-panel h-100">
                <div class="panel-title">
                    <div>
                        <span class="score-kicker">Top</span>
                        <h2>Mas carreras</h2>
                    </div>
                </div>
                <div class="scoreboard-card">
                    <div class="team-line">
                        <span>@(ViewData["EquipoMasCarreras"] ?? "-")</span>
                        <strong>@(ViewData["EquipoMasCarrerasTotal"] ?? 0)</strong>
                    </div>
                </div>
                <div class="d-grid gap-2 mt-3">
                    <a class="btn btn-primary" asp-controller="Jugadores" asp-action="Index"><i class="bi bi-people me-2"></i>Jugadores</a>
                    <a class="btn btn-outline-primary" asp-controller="Equipos" asp-action="Index"><i class="bi bi-shield me-2"></i>Equipos</a>
                </div>
            </section>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Estadísticas globales";
    var labelsJson = ViewData["TeamLabels"] as string ?? "[]";
    var dataJson = ViewData["TeamData"] as string ?? "[]";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="mb-0">Dashboard · Estadísticas</h1>
        <div class="text-muted">Visión general de equipos, jugadores y partidos</div>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm p-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-people-fill fs-3 text-primary me-3"></i>
                <div>
                    <div class="text-muted small">Equipos</div>
                    <div class="h4">@ViewData["TotalEquipos"]</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm p-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-badge-fill fs-3 text-success me-3"></i>
                <div>
                    <div class="text-muted small">Jugadores</div>
                    <div class="h4">@ViewData["TotalJugadores"]</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm p-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-calendar-event-fill fs-3 text-warning me-3"></i>
                <div>
                    <div class="text-muted small">Partidos</div>
                    <div class="h4">@ViewData["TotalPartidos"]</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm p-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-bar-chart-line-fill fs-3 text-danger me-3"></i>
                <div>
                    <div class="text-muted small">Carreras totales</div>
                    <div class="h4">@ViewData["TotalCarreras"]</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <strong>Carreras por equipo</strong>
                    <div class="text-muted small">Comparativa por equipos</div>
                </div>
            </div>
            <canvas id="chartTeams" height="120"></canvas>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm p-3 mb-3">
            <div class="text-muted small">Promedio general (carreras / partido)</div>
            <div class="h3 mt-2">@ViewData["PromedioGeneral"]</div>
        </div>

        @if(ViewData["EquipoMasCarreras"] != null)
        {
            <div class="card shadow-sm p-3">
                <div class="text-muted small">Equipo con más carreras</div>
                <div class="h5 mt-2">@ViewData["EquipoMasCarreras"] (@ViewData["EquipoMasCarrerasTotal"])</div>
            </div>
        }
    </div>
</div>

<section class="mt-4">
    <a class="btn btn-outline-primary" asp-controller="Jugadores" asp-action="Index"><i class="bi bi-people"></i> Ver jugadores</a>
    <a class="btn btn-outline-secondary ms-2" asp-controller="Equipos" asp-action="Index"><i class="bi bi-shield"></i> Ver equipos</a>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        const labels = @Html.Raw(labelsJson ?? "[]");
        const data = @Html.Raw(dataJson ?? "[]");

        const ctx = document.getElementById('chartTeams');
        if (ctx) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Carreras',
                        data: data,
                        backgroundColor: 'rgba(13,110,253,0.7)',
                        borderColor: 'rgba(13,110,253,1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }
    })();
</script>

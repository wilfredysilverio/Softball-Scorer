@* Minimal auth-only layout to style login/register without touching global layout *@
@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Autenticación";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Softball-Scorer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        /* Scoped styles for auth pages only */
        .auth-wrapper { min-height: 100vh; display: grid; place-items: center; background: #0f172a; }
        .auth-card { width: 100%; max-width: 440px; background: #ffffff; border-radius: 14px; padding: 32px 28px; box-shadow: 0 10px 30px rgba(0,0,0,.18); }
        .softball-brand { display:flex; align-items:center; gap:.5rem; }
        .softball-brand img { width: 28px; height: 28px; }
        .auth-title { font-weight: 700; }
        .auth-sub { color: #64748b; }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model Scoreboard.Web.Modelos.ViewModels.EstadisticasJugadorVm
@{
    ViewData["Title"] = "Estadisticas del jugador";
}

<div class="page-shell">
    <div class="page-header">
        <div>
            <span class="score-kicker">Jugador</span>
            <h1>@Model.Jugador.Nombre @Model.Jugador.Apellido</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Volver</a>
    </div>

    <section class="work-panel mb-4">
        <div class="detail-hero">
            <span class="player-number">#@Model.Jugador.NumeroUniforme</span>
            <div>
                <h2>@Model.Jugador.Nombre @Model.Jugador.Apellido</h2>
                <p>@Model.Jugador.Posicion - @(Model.Jugador.Equipo?.Nombre ?? "Sin equipo")</p>
            </div>
        </div>
    </section>

    <section class="stat-grid mb-4">
        <div class="metric-tile"><span>Juegos</span><strong>@Model.PartidosJugados</strong></div>
        <div class="metric-tile"><span>Turnos</span><strong>@Model.Turnos</strong></div>
        <div class="metric-tile"><span>Hits</span><strong>@Model.Hits</strong></div>
        <div class="metric-tile"><span>Carreras</span><strong>@Model.Carreras</strong></div>
        <div class="metric-tile metric-live"><span>HR</span><strong>@Model.HomeRuns</strong></div>
        <div class="metric-tile"><span>AVG</span><strong>@((Model.Turnos > 0) ? Model.Promedio.ToString("0.000") : "-.---")</strong></div>
    </section>

    <section class="stat-grid mb-4">
        <div class="metric-tile"><span>PA</span><strong>@Model.PA</strong></div>
        <div class="metric-tile"><span>BB</span><strong>@Model.BB</strong></div>
        <div class="metric-tile"><span>SO</span><strong>@Model.SO</strong></div>
        <div class="metric-tile"><span>OBP</span><strong>@((Model.PA > 0) ? Model.OBP.ToString("0.000") : "-.---")</strong></div>
        <div class="metric-tile"><span>SLG</span><strong>@((Model.AB > 0) ? Model.SLG.ToString("0.000") : "-.---")</strong></div>
        <div class="metric-tile"><span>OPS</span><strong>@((Model.PA > 0) ? Model.OPS.ToString("0.000") : "-.---")</strong></div>
    </section>

    <section class="work-panel">
        <div class="panel-title">
            <div>
                <span class="score-kicker">Bateo</span>
                <h2>Resumen por temporada</h2>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 mobile-stack-table">
                <thead>
                    <tr>
                        <th>Temporada</th><th>G</th><th>AB</th><th>R</th><th>H</th><th>2B</th><th>3B</th><th>HR</th><th>RBI</th><th>BB</th><th>SO</th><th>PA</th><th>AVG</th><th>OBP</th><th>SLG</th><th>OPS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lineas != null && Model.Lineas.Any())
                    {
                        foreach (var linea in Model.Lineas)
                        {
                            <tr>
                                <td data-label="Temporada">@linea.Temporada</td>
                                <td data-label="G">@linea.G</td>
                                <td data-label="AB">@linea.AB</td>
                                <td data-label="R">@linea.R</td>
                                <td data-label="H">@linea.H</td>
                                <td data-label="2B">@linea.Doubles</td>
                                <td data-label="3B">@linea.Triples</td>
                                <td data-label="HR">@linea.HR</td>
                                <td data-label="RBI">@linea.RBI</td>
                                <td data-label="BB">@linea.BB</td>
                                <td data-label="SO">@linea.SO</td>
                                <td data-label="PA">@linea.PA</td>
                                <td data-label="AVG">@linea.AVG.ToString("0.000")</td>
                                <td data-label="OBP">@linea.OBP.ToString("0.000")</td>
                                <td data-label="SLG">@linea.SLG.ToString("0.000")</td>
                                <td data-label="OPS">@linea.OPS.ToString("0.000")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="16" class="text-center text-muted py-4">Sin estadisticas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

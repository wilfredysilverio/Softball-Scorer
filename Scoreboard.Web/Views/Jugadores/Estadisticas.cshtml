@model Scoreboard.Web.Modelos.ViewModels.EstadisticasJugadorVm
@{
    ViewData["Title"] = "Estadísticas del jugador";
}

<div class="container-fluid py-4">
    <div class="card mb-4">
        <div class="card-body d-flex gap-3 align-items-center">
            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:84px;height:84px;font-size:1.5rem;">
                @((Model.Jugador.Nombre?.Substring(0,1) ?? "?") + (Model.Jugador.Apellido?.Substring(0,1) ?? ""))
            </div>
            <div>
                <h3 class="mb-0">@Model.Jugador.Nombre @Model.Jugador.Apellido <small class="text-muted">#@Model.Jugador.NumeroUniforme</small></h3>
                <div class="text-muted">@Model.Jugador.Posicion.ToString() • @(Model.Jugador.Equipo?.Nombre ?? "—")</div>
            </div>
            <div class="ms-auto">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs" id="statsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="resumen-tab" data-bs-toggle="tab" data-bs-target="#resumen" type="button" role="tab">Resumen</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="detalles-tab" data-bs-toggle="tab" data-bs-target="#detalles" type="button" role="tab">Estadísticas</button>
        </li>
    </ul>
    <div class="tab-content mt-3">
        <div class="tab-pane fade show active" id="resumen" role="tabpanel">
            <div class="row g-3">
                <div class="col-6 col-md-2">
                    <div class="card text-center p-3 shadow-sm">
                        <div class="text-muted small">Partidos</div>
                        <div class="h4 mt-2">@Model.PartidosJugados</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center p-3 shadow-sm">
                        <div class="text-muted small">Turnos</div>
                        <div class="h4 mt-2">@Model.Turnos</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center p-3 shadow-sm">
                        <div class="text-muted small">Hits</div>
                        <div class="h4 mt-2">@Model.Hits</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center p-3 shadow-sm">
                        <div class="text-muted small">Carreras</div>
                        <div class="h4 mt-2">@Model.Carreras</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center p-3 shadow-sm">
                        <div class="text-muted small">HR</div>
                        <div class="h4 mt-2">@Model.HomeRuns</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center p-3 shadow-sm">
                        <div class="text-muted small">AVG</div>
                        <div class="h4 mt-2">
                            @(
                                (Model.Turnos > 0) ? Model.Promedio.ToString("0.000") : "-.---"
                            )
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="detalles" role="tabpanel">
            <div class="card">
                <div class="card-body">
                    <h5>Tabla de bateo</h5>
                    <div class="mb-3">
                        <canvas id="playerChart" height="120"></canvas>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead>
                                <tr>
                                    <th>Temporada</th>
                                    <th>G</th>
                                    <th>AB</th>
                                    <th>R</th>
                                    <th>H</th>
                                    <th>2B</th>
                                    <th>3B</th>
                                    <th>HR</th>
                                    <th>RBI</th>
                                    <th>BB</th>
                                    <th>SO</th>
                                    <th>AVG</th>
                                    <th>OBP</th>
                                    <th>SLG</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Lineas != null && Model.Lineas.Any())
                                {
                                    foreach (var linea in Model.Lineas)
                                    {
                                        <tr>
                                            <td>@linea.Temporada</td>
                                            <td>@linea.G</td>
                                            <td>@linea.AB</td>
                                            <td>@linea.R</td>
                                            <td>@linea.H</td>
                                            <td>@linea.Doubles</td>
                                            <td>@linea.Triples</td>
                                            <td>@linea.HR</td>
                                            <td>@linea.RBI</td>
                                            <td>@linea.BB</td>
                                            <td>@linea.SO</td>
                                            <td>@(linea.AVG.ToString("0.000"))</td>
                                            <td>@(linea.OBP.ToString("0.000"))</td>
                                            <td>@(linea.SLG.ToString("0.000"))</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="14" class="text-center text-muted">No hay datos de bateo para este jugador.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const lineas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lineas ?? new List<Scoreboard.Web.Modelos.ViewModels.LineaTemporadaVm>()));
            if (!lineas || !lineas.length) return;

            const labels = lineas.map(l => l.Temporada).reverse();
+            const avgs = lineas.map(l => parseFloat((l.AVG || 0).toFixed(3))).reverse();
+            const obps = lineas.map(l => parseFloat((l.OBP || 0).toFixed(3))).reverse();
+            const slgs = lineas.map(l => parseFloat((l.SLG || 0).toFixed(3))).reverse();
+
            const ctx = document.getElementById('playerChart').getContext('2d');
+            new Chart(ctx, {
+                type: 'line',
+                data: {
+                    labels: labels,
+                    datasets: [
+                        { label: 'AVG', data: avgs, borderColor: '#0d6efd', backgroundColor: 'rgba(13,110,253,0.08)', tension: 0.2 },
+                        { label: 'OBP', data: obps, borderColor: '#198754', backgroundColor: 'rgba(25,135,84,0.06)', tension: 0.2 },
+                        { label: 'SLG', data: slgs, borderColor: '#dc3545', backgroundColor: 'rgba(220,53,69,0.06)', tension: 0.2 }
+                    ]
+                },
+                options: {
+                    responsive: true,
+                    scales: {
+                        y: { beginAtZero: true }
+                    }
+                }
+            });
+        })();
+    </script>
+}
+


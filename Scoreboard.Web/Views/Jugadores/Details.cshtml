@model Scoreboard.Web.Modelos.Jugador
@{
    ViewData["Title"] = "Detalles del jugador";
}
<h1 class="mb-4">Detalles del jugador</h1>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>

    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.NumeroUniforme</dd>

    <dt class="col-sm-3">Equipo</dt>
    <dd class="col-sm-9">@Model.Equipo?.Nombre</dd>

    <dt class="col-sm-3">Posición</dt>
    <dd class="col-sm-9">@Model.Posicion</dd>
</dl>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
    <a asp-action="Estadisticas" asp-route-id="@Model.Id" class="btn btn-outline-dark">Estadísticas</a>
</div>

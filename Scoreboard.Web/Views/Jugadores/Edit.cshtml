@model Scoreboard.Web.Modelos.Jugador
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Editar jugador";
}

<h1 class="mb-4">Editar jugador</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NumeroUniforme" class="form-label"></label>
        <input asp-for="NumeroUniforme" class="form-control" />
        <span asp-validation-for="NumeroUniforme" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EquipoId" class="form-label">Equipo</label>
        <select asp-for="EquipoId" class="form-select"
                asp-items="@(ViewBag.EquipoId as IEnumerable<SelectListItem>)">
            <option value="">-- Selecciona un equipo --</option>
        </select>
        <span asp-validation-for="EquipoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Posicion" class="form-label">Posición</label>
        <select asp-for="Posicion" class="form-select"
                asp-items="Html.GetEnumSelectList<Scoreboard.Web.Modelos.Posicion>()">
            <option value="">Seleccione una posición</option>
        </select>
        <span asp-validation-for="Posicion" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

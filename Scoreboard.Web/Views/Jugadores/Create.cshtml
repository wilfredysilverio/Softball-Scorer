@model Scoreboard.Web.Modelos.Jugador
@using Scoreboard.Web.Modelos

@{
    ViewData["Title"] = "Crear jugador";
}

<div class="page-shell">
    <div class="page-header">
        <div>
            <span class="score-kicker">Roster</span>
            <h1>Crear jugador</h1>
            <p>Registra un jugador para poder agregarlo al lineup y acumular sus estadisticas durante los partidos.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="form-panel">
        <div class="card shadow-sm">
            <div class="card-header">
                <i class="bi bi-person-plus me-2"></i>Datos del jugador
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
                    @Html.AntiForgeryToken()

                    <div class="col-12">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-0"></div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Nombre" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellido" class="form-label fw-semibold"></label>
                        <input asp-for="Apellido" class="form-control form-control-lg" placeholder="Apellido" />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NumeroUniforme" class="form-label fw-semibold">Numero</label>
                        <input asp-for="NumeroUniforme" type="number" class="form-control form-control-lg" placeholder="27" />
                        <span asp-validation-for="NumeroUniforme" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EquipoId" class="form-label fw-semibold">Equipo</label>
                        <select asp-for="EquipoId" class="form-select form-select-lg" asp-items="ViewBag.EquipoId">
                            <option value="">Selecciona equipo</option>
                        </select>
                        <span asp-validation-for="EquipoId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Posicion" class="form-label fw-semibold">Posicion</label>
                        <select asp-for="Posicion" class="form-select form-select-lg">
                            <option value="">Selecciona posicion</option>
                            <option value="@((int)Posicion.Utility)">Utility</option>
                            <option value="@((int)Posicion.Lanzador)">Pitcher</option>
                            <option value="@((int)Posicion.Receptor)">Receptor</option>
                            <option value="@((int)Posicion.PrimeraBase)">1B</option>
                            <option value="@((int)Posicion.SegundaBase)">2B</option>
                            <option value="@((int)Posicion.Campocorto)">SS</option>
                            <option value="@((int)Posicion.TerceraBase)">3B</option>
                            <option value="@((int)Posicion.JardinIzquierdo)">LF</option>
                            <option value="@((int)Posicion.JardinCentral)">CF</option>
                            <option value="@((int)Posicion.JardinDerecho)">RF</option>
                            <option value="@((int)Posicion.BateadorDesignado)">DH</option>
                        </select>
                        <span asp-validation-for="Posicion" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label for="fotoPerfil" class="form-label fw-semibold">Foto de perfil</label>
                        <input id="fotoPerfil" name="fotoPerfil" type="file" class="form-control form-control-lg" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span class="text-danger small field-validation-valid" data-valmsg-for="fotoPerfil" data-valmsg-replace="true"></span>
                        <div class="form-text">Opcional. Formatos permitidos: JPG, PNG o WEBP. Maximo 2 MB.</div>
                    </div>

                    <div class="col-12">
                        <div class="section-note">
                            Luego de guardar, podras seleccionarlo en el lineup de su equipo.
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-end flex-wrap gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle me-2"></i>Guardar jugador
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

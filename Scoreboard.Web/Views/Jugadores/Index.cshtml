@model IEnumerable<Scoreboard.Web.Modelos.Jugador>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Jugadores";
    var equipos = ViewBag.Equipos as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    string? q = ViewBag.q as string;
    string? equipoSeleccionado = ViewContext?.HttpContext?.Request?.Query["equipoId"].ToString();
    int paginaActual = ViewBag.PaginaActual as int? ?? 1;
    int pageSize = ViewBag.PageSize as int? ?? 15;
    int totalRegistros = ViewBag.TotalRegistros as int? ?? Model?.Count() ?? 0;
    int totalPaginas = ViewBag.TotalPaginas as int? ?? (pageSize > 0 ? (int)Math.Ceiling(totalRegistros / (double)pageSize) : 1);
    totalPaginas = totalPaginas <= 0 ? 1 : totalPaginas;
    paginaActual = Math.Max(1, Math.Min(paginaActual, totalPaginas));
    int paginaActualInicio = totalRegistros == 0 ? 0 : ((paginaActual - 1) * pageSize) + 1;
    int paginaActualFin = totalRegistros == 0 ? 0 : Math.Min(paginaActualInicio + pageSize - 1, totalRegistros);
    int windowSize = 2;
    int startPage = Math.Max(1, paginaActual - windowSize);
    int endPage = Math.Min(totalPaginas, paginaActual + windowSize);
}

<h2 class="mb-1">Jugadores</h2>
<p class="text-muted">Selecciona un jugador para ver acciones rápidas como estadísticas, detalles, edición o eliminación.</p>


<form method="get" class="row g-2 mb-4">
    <div class="col-md-4 col-lg-3">
        <select name="equipoId" class="form-select" onchange="this.form.submit()">
            <option value="">Todos los equipos</option>
            @foreach (var e in equipos)
            {
                <option value="@e.Value" selected="@(e.Selected ? "selected" : null)">@e.Text</option>
            }
        </select>
    </div>
    <div class="col-md-6 col-lg-6">
        <input type="text" name="q" value="@q" class="form-control" placeholder="Buscar por nombre, apellido o # uniforme..." />
    </div>
    <div class="col-md-2 col-lg-3 d-grid d-md-flex justify-content-md-end">
        <a asp-action="Create" class="btn btn-success">Nuevo jugador</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Equipo</th>
                        <th scope="col">Num. de jugador</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Apellido</th>
                        <th scope="col">Posición</th>
                        <th scope="col" class="text-end" style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay jugadores para mostrar.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="fila-jugador" data-id="@item.Id" tabindex="0" role="button" aria-controls="acciones-jugador-@item.Id" aria-expanded="false">
                                <td class="fw-semibold">@item.Equipo?.Nombre</td>
                                <td>@item.NumeroUniforme</td>
                                <td>@item.Nombre</td>
                                <td>@item.Apellido</td>
                                <td>@item.Posicion</td>
                                <td class="text-end small text-muted">
                                    <span class="toggle-caret" aria-hidden="true">▸</span>
                                    <span class="visually-hidden">Mostrar acciones</span>
                                </td>
                            </tr>
                            <tr class="collapse acciones-jugador" id="acciones-jugador-@item.Id">
                                <td colspan="6" class="py-3">
                                    <div class="d-flex gap-2 flex-wrap justify-content-end align-items-center">
                                        <a asp-action="Estadisticas" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Estadísticas</a>
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Detalles</a>
                                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                                <span class="visually-hidden">Opciones</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id" data-confirm="¿Eliminar jugador?">Eliminar</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<nav aria-label="Paginación de jugadores" class="mt-4">
    <ul class="pagination justify-content-center mb-2">
        <li class="page-item @(paginaActual <= 1 ? "disabled" : string.Empty)">
            <a class="page-link" href="@(paginaActual <= 1 ? "#" : Url.Action("Index", new { page = paginaActual - 1, equipoId = equipoSeleccionado, q }))" tabindex="@(paginaActual <= 1 ? "-1" : "0")">Anterior</a>
        </li>

        @if (startPage > 1)
        {
            <li class="page-item @(paginaActual == 1 ? "active" : string.Empty)">
                <a class="page-link" href="@Url.Action("Index", new { page = 1, equipoId = equipoSeleccionado, q })">1</a>
            </li>
            @if (startPage > 2)
            {
                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
            }
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == paginaActual ? "active" : string.Empty)">
                <a class="page-link" href="@Url.Action("Index", new { page = i, equipoId = equipoSeleccionado, q })">@i</a>
            </li>
        }

        @if (endPage < totalPaginas)
        {
            @if (endPage < totalPaginas - 1)
            {
                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
            }
            <li class="page-item @(paginaActual == totalPaginas ? "active" : string.Empty)">
                <a class="page-link" href="@Url.Action("Index", new { page = totalPaginas, equipoId = equipoSeleccionado, q })">@totalPaginas</a>
            </li>
        }

        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : string.Empty)">
            <a class="page-link" href="@(paginaActual >= totalPaginas ? "#" : Url.Action("Index", new { page = paginaActual + 1, equipoId = equipoSeleccionado, q }))" tabindex="@(paginaActual >= totalPaginas ? "-1" : "0")">Siguiente</a>
        </li>
    </ul>
    <p class="text-center text-muted small">Mostrando @paginaActualInicio &ndash; @paginaActualFin de @totalRegistros jugadores.</p>
</nav>

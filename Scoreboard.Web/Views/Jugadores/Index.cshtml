@model IEnumerable<Scoreboard.Web.Modelos.Jugador>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Jugadores";

    var equipos = ViewBag.Equipos as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    string? q = ViewBag.q as string;

    int paginaActual = ViewBag.PaginaActual != null ? (int)ViewBag.PaginaActual : 1;
    int totalPaginas = ViewBag.TotalPaginas != null ? (int)ViewBag.TotalPaginas : 1;
}

<h1 class="mb-3">Jugadores</h1>

<form method="get" id="filtroJugadoresForm" class="row g-2 align-items-center mb-3">

    <!-- Filtro por equipo -->
    <div class="col-md-3 col-sm-6">
        <select name="equipoId" class="form-select" id="EquipoId">
            <option value="">Todos los equipos</option>
            @foreach (var e in equipos)
            {
                <option value="@e.Value" selected="@(e.Selected ? "selected" : null)">@e.Text</option>
            }
        </select>
    </div>

    <!-- Búsqueda -->
    <div class="col-md-5 col-sm-6 position-relative">
        <input type="text"
               name="q"
               id="Busqueda"
               value="@q"
               class="form-control"
               placeholder="Buscar por nombre, apellido o # uniforme..."
               autocomplete="off" />
        <div id="autocompleteResults" class="list-group position-absolute w-100 shadow-sm" style="display: none; z-index: 1000; max-height: 300px; overflow-y: auto;"></div>
    </div>

    <!-- Paginación + Nuevo jugador (arriba a la derecha) -->
    <div class="col-md-4 d-flex justify-content-end align-items-center gap-2">
        @if (totalPaginas > 1)
        {
            <span class="small text-muted me-2">
                Página @paginaActual de @totalPaginas
            </span>

            @if (paginaActual > 1)
            {
                <a asp-action="Index"
                   asp-route-pagina="@(paginaActual - 1)"
                   asp-route-equipoId="@Context.Request.Query["equipoId"]"
                   asp-route-q="@q"
                   class="btn btn-outline-secondary btn-sm"
                   title="Página anterior">
                    ‹
                </a>
            }

            @if (paginaActual < totalPaginas)
            {
                <a asp-action="Index"
                   asp-route-pagina="@(paginaActual + 1)"
                   asp-route-equipoId="@Context.Request.Query["equipoId"]"
                   asp-route-q="@q"
                   class="btn btn-outline-secondary btn-sm"
                   title="Página siguiente">
                    ›
                </a>
            }
        }

        <a asp-action="Create" class="btn btn-success btn-sm">
            Nuevo jugador
        </a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Equipo</th>
                <th>#</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Posición</th>
                <th class="text-end" style="width: 220px;"></th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    No se encontraron jugadores con esos filtros.
                </td>
            </tr>
        }
        else
        {
            @foreach (var j in Model)
            {
                <tr>
                    <td>@j.Equipo?.Nombre</td>
                    <td>@j.NumeroUniforme</td>
                    <td>@j.Nombre</td>
                    <td>@j.Apellido</td>
                    <td>@j.Posicion</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@j.Id" class="btn btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@j.Id" class="btn btn-outline-primary">Editar</a>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("filtroJugadoresForm");
            const searchInput = document.getElementById("Busqueda");
            const equipoSelect = document.getElementById("EquipoId");
            const autocompleteResults = document.getElementById("autocompleteResults");
            let autocompleteTimer;
            const autocompleteDelay = 300;

            // Auto-submit solo cuando cambia el equipo
            if (equipoSelect) {
                equipoSelect.addEventListener("change", function () {
                    form.submit();
                });
            }

            // Autocomplete mientras escribe (sin submit automático)
            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    clearTimeout(autocompleteTimer);
                    const query = searchInput.value.trim();

                    if (query.length < 2) {
                        hideAutocomplete();
                        return;
                    }

                    autocompleteTimer = setTimeout(function () {
                        fetchAutocomplete(query);
                    }, autocompleteDelay);
                });

                // Ocultar autocomplete al presionar Enter (el form se envía naturalmente)
                searchInput.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") {
                        hideAutocomplete();
                    }
                });
            }

            // Función para obtener sugerencias
            function fetchAutocomplete(query) {
                fetch(`/Jugadores/Buscar?q=${encodeURIComponent(query)}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.length === 0) {
                            hideAutocomplete();
                            return;
                        }

                        autocompleteResults.innerHTML = "";
                        data.forEach(function (jugador) {
                            const item = document.createElement("a");
                            item.href = "#";
                            item.className = "list-group-item list-group-item-action";
                            item.textContent = jugador.nombreCompleto;
                            item.addEventListener("click", function (e) {
                                e.preventDefault();
                                searchInput.value = jugador.nombreCompleto;
                                hideAutocomplete();
                                form.submit();
                            });
                            autocompleteResults.appendChild(item);
                        });

                        autocompleteResults.style.display = "block";
                    })
                    .catch(error => {
                        console.error("Error al obtener sugerencias:", error);
                        hideAutocomplete();
                    });
            }

            // Función para ocultar autocomplete
            function hideAutocomplete() {
                autocompleteResults.style.display = "none";
                autocompleteResults.innerHTML = "";
            }

            // Cerrar autocomplete al hacer clic fuera
            document.addEventListener("click", function (e) {
                if (!searchInput.contains(e.target) && !autocompleteResults.contains(e.target)) {
                    hideAutocomplete();
                }
            });
        });
    </script>
}

@model IEnumerable<Scoreboard.Web.Modelos.Jugador>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Jugadores";
    var equipos = ViewBag.Equipos as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    string? q = ViewBag.q as string;
    string? equipoSeleccionado = ViewContext?.HttpContext?.Request?.Query["equipoId"].ToString();
    int paginaActual = ViewBag.PaginaActual as int? ?? 1;
    int pageSize = ViewBag.PageSize as int? ?? 15;
    int totalRegistros = ViewBag.TotalRegistros as int? ?? Model?.Count() ?? 0;
    int totalPaginas = ViewBag.TotalPaginas as int? ?? (pageSize > 0 ? (int)Math.Ceiling(totalRegistros / (double)pageSize) : 1);
    totalPaginas = totalPaginas <= 0 ? 1 : totalPaginas;
    paginaActual = Math.Max(1, Math.Min(paginaActual, totalPaginas));
    int paginaActualInicio = totalRegistros == 0 ? 0 : ((paginaActual - 1) * pageSize) + 1;
    int paginaActualFin = totalRegistros == 0 ? 0 : Math.Min(paginaActualInicio + pageSize - 1, totalRegistros);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div>
        <span class="score-kicker">Roster</span>
        <h2 class="mb-1">Jugadores</h2>
        <p class="text-muted mb-0">Busca jugadores, revisa su equipo y abre sus estadisticas sin pasos escondidos.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-person-plus me-2"></i>Nuevo jugador
    </a>
</div>

<form method="get" class="work-panel mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-4 col-lg-3">
            <label class="form-label">Equipo</label>
            <select name="equipoId" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los equipos</option>
                @foreach (var e in equipos)
                {
                    <option value="@e.Value" selected="@(e.Selected ? "selected" : null)">@e.Text</option>
                }
            </select>
        </div>
        <div class="col-md-6 col-lg-6">
            <label class="form-label">Buscar</label>
            <input type="text" name="q" value="@q" class="form-control" placeholder="Nombre, apellido o numero de uniforme" />
        </div>
        <div class="col-md-2 col-lg-3 d-grid d-md-flex gap-2 justify-content-md-end">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-2"></i>Buscar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

<div class="roster-grid">
    @if (Model == null || !Model.Any())
    {
        <section class="work-panel empty-state">
            <i class="bi bi-person-x"></i>
            <p>No hay jugadores para mostrar.</p>
            <a asp-action="Create" class="btn btn-success">Agregar jugador</a>
        </section>
    }
    else
    {
        foreach (var item in Model)
        {
            <article class="player-card">
                <div class="player-card-top">
                    @if (!string.IsNullOrWhiteSpace(item.FotoPerfilRuta))
                    {
                        <img src="@item.FotoPerfilRuta" alt="Foto de @item.Nombre @item.Apellido" class="player-avatar" />
                    }
                    else
                    {
                        <div class="player-avatar player-avatar-fallback" aria-hidden="true">
                            @item.Nombre.FirstOrDefault()@item.Apellido.FirstOrDefault()
                        </div>
                    }
                    <div class="player-number">#@item.NumeroUniforme</div>
                </div>
                <div class="player-main">
                    <h3>@item.Nombre @item.Apellido</h3>
                    <span>@item.Equipo?.Nombre</span>
                </div>
                <div class="player-meta">
                    <span><i class="bi bi-geo-alt"></i> @item.Posicion</span>
                </div>
                <div class="player-actions">
                    <a asp-action="Estadisticas" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Estadisticas</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                </div>
            </article>
        }
    }
</div>

<nav aria-label="Paginacion de jugadores" class="mt-4">
    <ul class="pagination justify-content-center mb-2">
        <li class="page-item @(paginaActual <= 1 ? "disabled" : string.Empty)">
            <a class="page-link" href="@(paginaActual <= 1 ? "#" : Url.Action("Index", new { page = paginaActual - 1, equipoId = equipoSeleccionado, q }))">Anterior</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Pagina @paginaActual de @totalPaginas</span>
        </li>
        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : string.Empty)">
            <a class="page-link" href="@(paginaActual >= totalPaginas ? "#" : Url.Action("Index", new { page = paginaActual + 1, equipoId = equipoSeleccionado, q }))">Siguiente</a>
        </li>
    </ul>
    <p class="text-center text-muted small">Mostrando @paginaActualInicio - @paginaActualFin de @totalRegistros jugadores.</p>
</nav>

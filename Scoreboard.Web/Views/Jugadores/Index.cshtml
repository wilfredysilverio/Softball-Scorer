@model IEnumerable<Scoreboard.Web.Modelos.Jugador>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Jugadores";
    var equipos = ViewBag.Equipos as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    string q = ViewBag.q as string ?? "";
    string equipoId = (string?)Context.Request.Query["equipoId"] ?? "";
}

<div class="container-fluid py-4">

    <!-- Encabezado (título a la izq, acciones a la der) -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="mb-0">Jugadores</h1>
            <div class="text-muted small">Gestiona y busca jugadores por equipo, nombre o número.</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            <a asp-action="Create" class="btn btn-success">Nuevo jugador</a>
        </div>
    </div>

    <!-- Filtros (GET) -->
    <form asp-action="Index" method="get" class="row g-2 align-items-center mb-3" id="formFiltros">
        <div class="col-12 col-md-4">
            <!-- asp-items: sin errores de TagHelper -->
            <select name="equipoId" class="form-select"
                    asp-items="@(new SelectList(equipos, nameof(SelectListItem.Value), nameof(SelectListItem.Text), equipoId))">
                <option value="">Todos los equipos</option>
            </select>
        </div>

        <div class="col-12 col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input name="q" id="txtBuscar" value="@q" class="form-control"
                       placeholder="Buscar por nombre, apellido o # uniforme…" autocomplete="off" />
                <button class="btn btn-outline-secondary" type="button" id="btnLimpiar" title="Limpiar">×</button>
            </div>
        </div>

        <div class="col-12 col-md-2 d-grid d-md-block">
            <button class="btn btn-primary w-100" type="submit" id="btnFiltrar">Filtrar</button>
        </div>
    </form>

    <!-- Tabla -->
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle" id="tablaJugadores">
                <thead>
                    <tr>
                        <th>Equipo</th>
                        <th style="width:80px">#</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Posición</th>
                        <th class="text-end" style="width:260px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in Model)
                    {
                        var equipo = j.Equipo?.Nombre ?? "";
                        var posText = Convert.ToString(j.Posicion) ?? ""; // enum -> texto seguro
                        var nombre = j.Nombre ?? "";
                        var apellido = j.Apellido ?? "";

                        <tr data-equipo="@equipo.ToLower()"
                            data-numero="@j.NumeroUniforme"
                            data-nombre="@nombre.ToLower()"
                            data-apellido="@apellido.ToLower()">
                            <td>@equipo</td>
                            <td>@j.NumeroUniforme</td>
                            <td class="fw-semibold">@nombre</td>
                            <td>@apellido</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(posText))
                                {
                                    <span class="badge rounded-pill text-bg-light border">@posText</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-end">
                                <a asp-action="Estadisticas" asp-route-id="@j.Id" class="btn btn-sm btn-outline-info">Estadísticas</a>
                                <a asp-action="Details" asp-route-id="@j.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@j.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@j.Id" class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar jugador?">Borrar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-muted small mt-2" id="resumen">
            @Model.Count() @(Model.Count() == 1 ? "jugador" : "jugadores")
        </div>
    }
    else
    {
        <div class="border rounded-3 p-4 text-center bg-light">
            <div class="h5 mb-1">No hay jugadores para mostrar</div>
            <div class="text-muted mb-3">Agrega el primero para comenzar a llevar sus estadísticas.</div>
            <a asp-action="Create" class="btn btn-success">Nuevo jugador</a>
        </div>
    }
</div>

@section Scripts {
<script>
(() => {
    const input = document.getElementById('txtBuscar');
    const btnLimpiar = document.getElementById('btnLimpiar');
    const filas = Array.from(document.querySelectorAll('#tablaJugadores tbody tr'));
    const resumen = document.getElementById('resumen');

    const norm = (t) => (t || '').toString().trim().toLowerCase();

    function aplicar() {
        if (!filas.length) return;
        const term = norm(input?.value);
        let visibles = 0;

        filas.forEach(tr => {
            const show = !term
                || (tr.dataset.equipo || '').includes(term)
                || (tr.dataset.nombre || '').includes(term)
                || (tr.dataset.apellido || '').includes(term)
                || (tr.dataset.numero || '').includes(term);
            tr.style.display = show ? '' : 'none';
            if (show) visibles++;
        });

        if (resumen) resumen.textContent = visibles + ' ' + (visibles === 1 ? 'jugador' : 'jugadores');
    }

    let t;
    input?.addEventListener('input', () => { clearTimeout(t); t = setTimeout(aplicar, 150); });
    btnLimpiar?.addEventListener('click', () => { if (!input) return; input.value = ''; aplicar(); input.focus(); });

    aplicar(); // primer pintado
})();
</script>
}

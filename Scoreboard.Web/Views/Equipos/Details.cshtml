@model Scoreboard.Web.Modelos.Equipo
@{
    ViewData["Title"] = "Equipo";
}

<div class="page-shell">
    <div class="page-header">
        <div>
            <span class="score-kicker">Equipo</span>
            <h1>@Model.Nombre</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Volver</a>
    </div>

    <section class="work-panel">
        <div class="detail-hero">
            @if (!string.IsNullOrWhiteSpace(Model.LogoRuta))
            {
                <img src="@Model.LogoRuta" alt="Logo de @Model.Nombre" class="team-logo team-logo-lg" />
            }
            else
            {
                <div class="team-logo team-logo-lg team-logo-fallback" aria-hidden="true">
                    <i class="bi bi-shield-fill"></i>
                </div>
            }
            <div>
                <h2>@Model.Nombre</h2>
                <p>@(string.IsNullOrWhiteSpace(Model.Ciudad) ? "Sin ciudad" : Model.Ciudad)</p>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-action="Estadisticas" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-bar-chart me-2"></i>Estadisticas</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-2"></i>Editar</a>
        </div>
    </section>
</div>

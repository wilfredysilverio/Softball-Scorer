@model IEnumerable<Scoreboard.Web.Modelos.Equipo>
@{
    ViewData["Title"] = "Equipos";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div>
        <span class="score-kicker">Clubes</span>
        <h2 class="mb-1">Equipos</h2>
        <p class="text-muted mb-0">Administra los equipos que pueden jugar como casa o visitante.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-shield-plus me-2"></i>Crear equipo
    </a>
</div>

<div class="team-grid">
    @if (Model == null || !Model.Any())
    {
        <section class="work-panel empty-state">
            <i class="bi bi-shield-x"></i>
            <p>No hay equipos para mostrar.</p>
            <a asp-action="Create" class="btn btn-primary">Crear equipo</a>
        </section>
    }
    else
    {
        foreach (var e in Model)
        {
            <article class="team-card">
                @if (!string.IsNullOrWhiteSpace(e.LogoRuta))
                {
                    <img src="@e.LogoRuta" alt="Logo de @e.Nombre" class="team-logo" />
                }
                else
                {
                    <div class="team-logo team-logo-fallback" aria-hidden="true">
                        <i class="bi bi-shield-fill"></i>
                    </div>
                }
                <div>
                    <h3>@e.Nombre</h3>
                    <span>@(string.IsNullOrWhiteSpace(e.Ciudad) ? "Sin ciudad" : e.Ciudad)</span>
                </div>
                <div class="team-actions">
                    <a asp-action="Estadisticas" asp-route-id="@e.Id" class="btn btn-sm btn-primary">Estadisticas</a>
                    <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                </div>
            </article>
        }
    }
</div>

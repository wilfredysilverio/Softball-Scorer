@model IEnumerable<Scoreboard.Web.Modelos.Equipo>
    @{
    ViewData["Title"] = "Equipos";
    }

    <h2 class="mb-1">Equipos</h2>
    <p class="text-muted">Selecciona un equipo para ver acciones rápidas como estadísticas, edición o eliminación.</p>

    <p>
        <a class="btn btn-primary" asp-action="Create">Crear equipo</a>
    </p>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Ciudad</th>
                        <th scope="col" class="text-end" style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No hay equipos para mostrar.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model)
                        {
                            <tr class="fila-equipo" data-id="@e.Id" tabindex="0" role="button" aria-controls="acciones-equipo-@e.Id" aria-expanded="false">
                                <td>@e.Id</td>
                                <td class="fw-semibold">@e.Nombre</td>
                                <td>@e.Ciudad</td>
                                <td class="text-end small text-muted">
                                    <span class="toggle-caret" aria-hidden="true">▸</span>
                                    <span class="visually-hidden">Mostrar acciones</span>
                                </td>
                            </tr>
                            <tr class="collapse acciones-equipo" id="acciones-equipo-@e.Id">
                                <td colspan="4" class="py-3">
                                    <div class="d-flex gap-2 flex-wrap justify-content-end align-items-center">
                                        <a asp-action="Estadisticas" asp-route-id="@e.Id" class="btn btn-outline-info btn-sm">Estadísticas</a>
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-outline-secondary btn-sm">Detalles</a>
                                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                                <span class="visually-hidden">Opciones</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@e.Id" data-confirm="¿Eliminar equipo?">Eliminar</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

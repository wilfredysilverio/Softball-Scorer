@model Scoreboard.Web.Modelos.Equipo
@{
    ViewData["Title"] = "Crear equipo";
}

<div class="page-shell">
    <div class="page-header">
        <div>
            <span class="score-kicker">Clubes</span>
            <h1>Crear equipo</h1>
            <p>Agrega un equipo para programar partidos como casa o visitante.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="form-panel">
        <div class="card shadow-sm">
            <div class="card-header">
                <i class="bi bi-shield-plus me-2"></i>Datos del equipo
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
                    @Html.AntiForgeryToken()

                    <div class="col-12">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-0"></div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ej. Tigres de Villa Duarte" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Ciudad" class="form-label fw-semibold"></label>
                        <input asp-for="Ciudad" class="form-control form-control-lg" placeholder="Ej. Santo Domingo Este" />
                        <span asp-validation-for="Ciudad" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label for="logoEquipo" class="form-label fw-semibold">Logo del equipo</label>
                        <input id="logoEquipo" name="logoEquipo" type="file" class="form-control form-control-lg" accept=".jpg,.jpeg,.png,.webp,.svg,image/jpeg,image/png,image/webp,image/svg+xml" />
                        <span class="text-danger small field-validation-valid" data-valmsg-for="logoEquipo" data-valmsg-replace="true"></span>
                        <div class="form-text">Opcional. Formatos permitidos: JPG, PNG, WEBP o SVG. Maximo 2 MB.</div>
                    </div>

                    <div class="col-12">
                        <div class="section-note">
                            Despues de guardar el equipo, puedes agregar sus jugadores desde el modulo Jugadores.
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-end flex-wrap gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle me-2"></i>Guardar equipo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@*
Pantalla para solicitar recuperacion de contrasena.
Este archivo muestra el formulario donde el usuario escribe su email.
La logica esta en ForgotPassword.cshtml.cs.
Pertenece al modulo Identity/Account y usa Razor Pages, no MVC Controller.
*@
@model Scoreboard.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contrasena";
}
<h2>Recuperar contrasena</h2>
<p>Introduce tu email y te enviaremos un enlace para restablecer tu contrasena.</p>
<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Enviar enlace</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

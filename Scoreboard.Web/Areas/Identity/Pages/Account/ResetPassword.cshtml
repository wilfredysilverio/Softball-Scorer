@page
@*
Pantalla para restablecer contrasena.
Este archivo muestra el formulario de nueva contrasena y confirmacion.
La logica esta en ResetPassword.cshtml.cs.
Pertenece al modulo Identity/Account y recibe email + token.
*@
@model Scoreboard.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contrasena";
}
<h2>Restablecer contrasena</h2>
<form method="post">
    <input type="hidden" asp-for="Input.Email" />
    <input type="hidden" asp-for="Input.Token" />
    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <input asp-for="Input.NewPassword" class="form-control" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Cambiar contrasena</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
